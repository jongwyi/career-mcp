# 복사해서 .env 로 쓴다. .env 는 커밋되지 않는다.

# Supabase — 프로젝트 설정 > API
SUPABASE_URL=https://<project-ref>.supabase.co

# service_role 키: RLS 를 우회한다. 로컬 MCP 서버와 GH Actions 워커 전용.
# 크롬 확장에는 절대 넣지 않는다.
SUPABASE_SERVICE_KEY=

# publishable(anon) 키: 크롬 확장용. RLS 로 raw_postings INSERT 만 가능.
SUPABASE_PUBLISHABLE_KEY=

# 마이그레이션 실행용 (scripts/migrate.py). 대시보드 > Connect > Session pooler.
# 직접 접속 호스트(db.<ref>.supabase.co)는 IPv6 전용이라 환경에 따라 막힌다.
# 비밀번호에 특수문자가 있으면 URL 인코딩할 것 (! -> %21)
SUPABASE_DB_URL=

# 채용 API
DATA_GO_KR_SERVICE_KEY=          # 재정경제부 공공기관 채용정보 (자동승인)
SARAMIN_ACCESS_KEY=              # 사람인 오픈 API (심사 필요)
